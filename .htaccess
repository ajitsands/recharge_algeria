<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle CORS Preflight Options
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # Route /api and /api/* to backend PHP handler
    RewriteRule ^api(/.*)?$ backend/index.php [QSA,L]

    # Serve existing files/directories directly from frontend/dist if built there
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA Fallback: If dist/index.html exists, route to it
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
    RewriteRule ^(.*)$ frontend/dist/index.html [L]

    # Alternative: Route to root index.html
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
